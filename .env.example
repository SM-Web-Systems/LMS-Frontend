# API base URL for the LMS backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# WordPress parent origin(s) for postMessage token handoff (iframe embed). Comma-separated if both http+https:
# VITE_WORDPRESS_ORIGIN=http://yoursite.local,https://yoursite.local
VITE_WORDPRESS_ORIGIN=http://sm-lms-test.local,https://sm-lms-test.local

# Optional: Google OAuth client ID. When set, the login page shows "Sign in with Google".
# Create a Web application client at https://console.cloud.google.com/apis/credentials
# and add your app origin (e.g. http://localhost:5173) to Authorized JavaScript origins.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
